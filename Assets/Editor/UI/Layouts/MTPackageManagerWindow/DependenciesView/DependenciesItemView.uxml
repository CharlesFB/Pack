<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; flex-direction: column;">
        <ui:VisualElement name="isUsing" style="flex-grow: initial; flex-direction: row;">
            <ui:Label tabindex="-1" text="Is Using" parse-escape-sequences="true" display-tooltip-when-elided="true" name="lbIsUsing" style="-unity-font-style: bold; -unity-text-align: middle-center; width: 80px; min-width: 80px; max-width: 80px; align-self: flex-start; height: 30px;" />
            <ui:VisualElement name="veUsingDep" style="flex-grow: initial;" />
        </ui:VisualElement>
        <ui:VisualElement name="usedBy" style="flex-grow: initial; flex-direction: row;">
            <ui:Label tabindex="-1" text="Used By" parse-escape-sequences="true" display-tooltip-when-elided="true" name="lbUsedBy" style="-unity-font-style: bold; -unity-text-align: middle-center; font-size: 14px; width: 80px; min-width: 80px; max-width: 80px; align-self: flex-start; height: 30px;" />
            <ui:VisualElement name="veUesdDep" style="flex-grow: initial;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
