<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Editor/UI/Styles/GlobalStyles/ItemRowHover.uss?fileID=7433441132597879392&amp;guid=a1b2c3d4e5f60718293a4b5c6d7e8f90&amp;type=3#ItemRowHover" />
    <ui:VisualElement class="item-row" style="flex-direction: row; align-items: stretch; height: 35px; justify-content: space-between; text-overflow: ellipsis; margin-right: 20px; padding-right: 10px; padding-left: 10px; min-height: 35px; max-height: 40px;">
        <ui:Label text="ZipName" display-tooltip-when-elided="true" name="lbName" style="width: auto; -unity-text-align: middle-left; align-self: center;" />
        <ui:VisualElement name="VisualElement" style="flex-grow: 1; flex-direction: row; justify-content: flex-end; padding-right: 0; align-self: center; height: 70%; max-height: 70px;">
            <ui:Button text="Remove" parse-escape-sequences="true" display-tooltip-when-elided="true" name="btnRemove" style="width: 70px; margin-right: 15px; align-self: center; height: 100%;" />
            <ui:Button text="Unzip" display-tooltip-when-elided="true" name="btnUnZip" style="width: 70px; align-self: center; height: 100%;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
