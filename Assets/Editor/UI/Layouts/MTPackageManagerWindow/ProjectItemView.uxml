            <ui:Label tabindex="-1" parse-escape-sequences="true" display-tooltip-when-elided="true" name="lbStatus" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; max-width: 17px; max-height: 17px; min-width: 17px; min-height: 17px; align-self: center; background-image: url(&quot;project://database/Assets/Editor/UI/Imgs/ok.png?fileID=2800000&amp;guid=5b85655c34daf4fc0ac6420d1e42661b&amp;type=3#ok&quot;);" />
