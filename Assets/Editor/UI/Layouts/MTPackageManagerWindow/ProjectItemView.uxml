<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Editor/UI/Styles/ProjectItemView.uss?fileID=7433441132597879392&amp;guid=3cdafdfcdc4945e4947e10ff366cde6e&amp;type=3#ProjectItemView" />
    <ui:VisualElement class="project-item-row" style="flex-direction: row; align-items: stretch; height: 44px; justify-content: space-between; margin-right: 0; text-overflow: ellipsis; align-self: auto; padding-right: 15px; padding-left: 10px; max-height: 44px; min-height: 44px; border-bottom-width: 1px; border-left-color: rgb(24, 24, 24); border-right-color: rgb(24, 24, 24); border-top-color: rgb(24, 24, 24); border-bottom-color: rgb(24, 24, 24); background-image: none;">
        <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
