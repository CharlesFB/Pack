<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Editor/UI/Styles/PluginImportWindow.uss?fileID=7433441132597879392&amp;guid=7eb281cc55bcb44f59347ced8afabaad&amp;type=3#PluginImportWindow" />
    <ui:Label tabindex="-1" text="准备安装 com.magictavern.package[project-tag] " parse-escape-sequences="true" display-tooltip-when-elided="true" name="lbDescription" style="-unity-text-align: middle-left; align-self: stretch; min-height: 30px; max-height: 40px; margin-left: 10px; height: 30px; font-size: 14px; text-overflow: ellipsis;" />
    <ui:Label tabindex="-1" text="请选择导入其依赖的插件：" parse-escape-sequences="true" display-tooltip-when-elided="true" style="height: 30px; min-height: 30px; max-height: 40px; margin-left: 10px; font-size: 14px;" />
    <ui:VisualElement name="VisualElement" style="flex-direction: column; width: 100%; height: 100%; justify-content: space-between; min-height: 40%; max-height: 100%;">
        <ui:ListView name="lvPluginItemContainer" focusable="false" virtualization-method="DynamicHeight" show-border="false" fixed-item-height="40" style="border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); padding-left: 4px; padding-right: 4px; padding-top: 4px; padding-bottom: 4px; margin-left: 5px; margin-right: 5px; margin-top: 5px; margin-bottom: 5px; border-top-left-radius: 5px; border-bottom-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; height: 100%; min-height: 60%;" />
        <ui:VisualElement name="VisualElement" style="align-items: stretch; padding-bottom: 5px; flex-direction: row; margin-left: 3%; margin-right: 3%; margin-top: 2%; margin-bottom: 2%; justify-content: space-between; align-self: stretch; height: 50px;">
            <ui:Button text="Cancel" display-tooltip-when-elided="true" name="btnCancel" style="width: auto; align-items: stretch; -unity-text-align: middle-center; white-space: nowrap; font-size: 12px; height: 100%; align-self: stretch; justify-content: center; max-width: 50%; min-width: 45%; min-height: auto;" />
            <ui:Button text="Import" parse-escape-sequences="true" display-tooltip-when-elided="true" name="btnImport" style="height: 100%; min-width: 45%; max-width: 50%; font-size: 12px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
