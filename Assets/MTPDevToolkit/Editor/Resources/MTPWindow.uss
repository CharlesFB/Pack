#ButtonHolder {
    height: 50px;
    width: auto;
    background-color: rgb(21, 132, 67);
    display: flex;
    flex-direction: row;
}

#Container {
    background-color: rgb(242, 246, 250);
    display: flex;
    flex-direction: row;
    width: auto;
}

#RightPanel {
    position: relative;
    flex: 1;
    width: auto;
    border-width: 2px;
    border-color: rgb(21, 132, 67);
}

#LeftPanel {
    display: flex;
    -unity-text-align: middle-center;
    flex: 1;
    width: auto;
    border-width: 2px;
    border-color: rgb(21, 132, 67);
}

#RightTopPanel {
    border-width: 1px;
    border-color: rgb(21, 132, 67);
    -unity-text-align: middle-center;
    display: flex;
    flex: 1;
}

#RightBottomPanel {
    border-width: 1px;
    border-color: rgb(21, 132, 67);
    -unity-text-align: middle-center;
    display: flex;
    flex: 1;
}

.the-uxml-listview {
    --unity-item-height: 16;
    height: 200px;
}

#lbError {
    color: rgb(255, 66, 66);
}

#lbWarning {
    color: rgb(255, 205, 57);
    display: flex;
}

#inputSearch > Label {
    display: none;
    opacity: 1;
}
