<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="VisualElement" style="flex-grow: 1; height: 70px; width: 100%; max-height: 70px;">
        <ui:VisualElement style="flex-direction: row; align-items: center; height: 35px; justify-content: flex-end; width: 100%;">
            <ui:Toggle label="UnityPackageName.unitypackage" name="tgPluginItem" style="width: auto; justify-content: flex-end; align-items: center; align-self: center; max-width: 90%; margin-left: 6px; font-size: 15px; -unity-text-align: upper-right;" />
        </ui:VisualElement>
        <ui:VisualElement name="veDirChosen" style="flex-grow: 1; height: 176px; width: 100%; flex-direction: row; justify-content: flex-end; align-items: stretch; max-height: 30px;">
            <ui:Label tabindex="-1" text="解压目录：" parse-escape-sequences="true" display-tooltip-when-elided="true" style="-unity-text-align: middle-right; font-size: 15px;" />
            <ui:Label tabindex="-1" text="/Assets" parse-escape-sequences="true" display-tooltip-when-elided="true" name="lbUnzipRoot" style="min-width: 200px; -unity-text-align: middle-right; background-color: rgb(79, 79, 79); max-width: 200px; overflow: hidden; flex-shrink: 0; font-size: 15px;" />
            <ui:Button text="Chosse Dir" parse-escape-sequences="true" display-tooltip-when-elided="true" name="btnChooseDir" style="max-height: 30px; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; font-size: 15px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
