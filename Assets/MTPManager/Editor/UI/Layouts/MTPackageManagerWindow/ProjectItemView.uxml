<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement class="project-item-row" style="flex-direction: row; align-items: stretch; height: 44px; justify-content: space-between; margin-right: 0; padding-right: 15px; padding-left: 10px; max-height: 44px; min-height: 44px; border-bottom-width: 1px; border-left-color: rgb(24, 24, 24); border-right-color: rgb(24, 24, 24); border-top-color: rgb(24, 24, 24); border-bottom-color: rgb(24, 24, 24);">
        <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
            <ui:Label text="DisplayName" name="lbDisplayName" style="width: auto; margin-bottom: 4px; margin-top: 4px; align-self: stretch; padding-left: 2px; margin-left: 0; font-size: 16px; -unity-text-align: middle-left; color: rgb(236, 236, 236); -unity-font-style: bold; max-width: 180px;" />
            <ui:Label text="DEP" name="lbDep" style="background-color: rgb(10, 10, 10); color: rgb(236, 236, 236); font-size: 10px; -unity-font-style: bold; border-top-left-radius: 2px; border-top-right-radius: 2px; border-bottom-right-radius: 2px; border-bottom-left-radius: 2px; align-self: center; max-width: 32px; max-height: 17px; min-width: 32px; min-height: 17px; -unity-text-align: middle-center; margin-left: 8px;" />
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 1; flex-direction: row; justify-content: flex-end; align-self: stretch;">
            <ui:Label text="Debug" name="lbDebug" style="background-color: rgb(185, 185, 185); color: rgb(58, 58, 58); font-size: 10px; -unity-font-style: bold; border-top-left-radius: 7px; border-top-right-radius: 7px; border-bottom-right-radius: 7px; border-bottom-left-radius: 7px; align-self: center; max-width: 50px; max-height: 16px; min-width: 50px; min-height: 16px; -unity-text-align: middle-center;" />
            <ui:Label text="1.20.12" name="lbVersion" style="-unity-text-align: middle-center; min-width: 60px; max-width: 60px; color: rgb(236, 236, 236); font-size: 15px;" />
            <ui:Label name="lbStatus" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; max-width: 17px; max-height: 17px; min-width: 17px; min-height: 17px; align-self: center;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
