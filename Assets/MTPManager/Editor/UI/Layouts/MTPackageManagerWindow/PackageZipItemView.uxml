<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement class="item-row" style="flex-direction: row; align-items: stretch; height: 40px; justify-content: space-between; margin-right: 0; padding-right: 30px; padding-left: 10px; min-height: 40px; max-height: 40px;">
        <ui:Label text="ZipName" display-tooltip-when-elided="true" name="lbName" style="width: auto; -unity-text-align: middle-left; align-self: center; font-size: 15px;" />
        <ui:VisualElement name="VisualElement" style="flex-grow: 1; flex-direction: row; justify-content: flex-end; padding-right: 0; align-self: center; height: 70%; max-height: 70px;">
            <ui:Button text="Remove" parse-escape-sequences="true" display-tooltip-when-elided="true" name="btnRemove" style="width: 70px; margin-right: 15px; align-self: center; height: 25px; font-size: 13px; max-height: 25px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;" />
            <ui:Button text="Unzip" display-tooltip-when-elided="true" name="btnUnZip" style="width: 70px; align-self: center; height: 25px; font-size: 13px; max-height: 25px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
