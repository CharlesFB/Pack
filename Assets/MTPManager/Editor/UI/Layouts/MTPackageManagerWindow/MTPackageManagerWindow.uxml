<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; flex-direction: column; justify-content: space-between; border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; min-width: 1000px; min-height: 650px; align-self: stretch; border-left-color: rgba(236, 0, 123, 0); border-right-color: rgba(236, 0, 123, 0); border-top-color: rgba(236, 0, 123, 0); border-bottom-color: rgba(236, 0, 123, 0); height: 100%;">
        <ui:VisualElement name="NavigationBar" style="flex-grow: 1; max-height: 32px; align-self: stretch; flex-direction: row; background-color: rgb(71, 71, 71); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(15, 15, 15); border-right-color: rgb(15, 15, 15); border-top-color: rgb(15, 15, 15); border-bottom-color: rgb(15, 15, 15); min-height: 32px;">
            <ui:Button text="Package: FrontEngine" name="ddPackage" class="ddType" style="align-self: stretch; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-bottom: 0; padding-left: 8px; padding-right: 8px; -unity-text-align: middle-left; font-size: 14px; border-top-width: 0; border-right-width: 1px; border-bottom-width: 0; border-left-width: 0; border-left-color: rgb(20, 20, 20); border-right-color: rgb(20, 20, 20); border-top-color: rgb(20, 20, 20); border-bottom-color: rgb(20, 20, 20); color: rgb(231, 231, 231); min-width: 160px;" />
            <ui:Button text="Sort: Name (asc)" name="ddSort" class="ddType" style="align-self: stretch; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-bottom: 0; padding-left: 8px; padding-right: 8px; -unity-text-align: middle-left; font-size: 14px; border-top-width: 0; border-right-width: 1px; border-bottom-width: 0; border-left-width: 0; border-left-color: rgb(20, 20, 20); border-right-color: rgb(20, 20, 20); border-top-color: rgb(20, 20, 20); border-bottom-color: rgb(20, 20, 20); color: rgb(231, 231, 231); min-width: 150px;" />
            <ui:Button text="Setting" name="btnSetting" class="btnNav" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-bottom: 0; margin-right: 0; margin-left: 0; align-self: stretch; min-width: 80px; color: rgb(219, 219, 219); border-left-color: rgb(20, 20, 20); border-right-color: rgb(20, 20, 20); border-top-color: rgb(20, 20, 20); border-bottom-color: rgb(20, 20, 20); border-top-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 14px;" />
            <ui:Button text="Reset" name="btnReset" class="btnNav" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-bottom: 0; margin-right: 0; margin-left: 0; align-self: stretch; min-width: 80px; color: rgb(219, 219, 219); border-left-color: rgb(20, 20, 20); border-right-color: rgb(20, 20, 20); border-top-color: rgb(20, 20, 20); border-bottom-color: rgb(20, 20, 20); border-top-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 14px;" />
            <ui:Button text="Clear" name="btnClear" class="btnNav" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-bottom: 0; margin-right: 0; margin-left: 0; align-self: stretch; min-width: 80px; color: rgb(219, 219, 219); border-left-color: rgb(20, 20, 20); border-right-color: rgb(20, 20, 20); border-top-color: rgb(20, 20, 20); border-bottom-color: rgb(20, 20, 20); border-top-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 14px;" />
            <ui:Button text="Quick Install" name="btnQuickInstall" class="btnNav" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-bottom: 0; margin-right: 0; margin-left: 0; align-self: stretch; min-width: 120px; color: rgb(219, 219, 219); border-left-color: rgb(20, 20, 20); border-right-color: rgb(20, 20, 20); border-top-color: rgb(20, 20, 20); border-bottom-color: rgb(20, 20, 20); border-top-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 14px;" />
            <ui:Button text="Dependencies Graph" name="btnDependenciesGraph" class="btnNav" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-bottom: 0; margin-right: 0; margin-left: 0; align-self: stretch; min-width: 170px; color: rgb(219, 219, 219); border-left-color: rgb(20, 20, 20); border-right-color: rgb(20, 20, 20); border-top-color: rgb(20, 20, 20); border-bottom-color: rgb(20, 20, 20); border-top-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 14px;" />
            <ui:VisualElement style="flex-grow: 1;" />
            <ui:VisualElement name="SearchingFile" style="flex-grow: 1; margin-top: 2px; margin-bottom: 2px; margin-right: 6px; margin-left: 6px; flex-direction: row; justify-content: flex-start; align-items: stretch; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(25, 25, 25); border-right-color: rgb(25, 25, 25); border-top-color: rgb(25, 25, 25); border-bottom-color: rgb(25, 25, 25); background-color: rgb(55, 55, 55); align-self: stretch; padding-right: 5px; padding-left: 8px; max-width: 260px;">
                <ui:VisualElement name="imgSearch" style="flex-grow: 1; max-width: 20px; max-height: 20px; align-self: center; min-width: 20px; min-height: 20px;" />
                <ui:VisualElement style="flex-grow: 1; flex-direction: row; align-self: stretch; justify-content: center; padding-top: 2px; padding-bottom: 2px; padding-right: 6px; padding-left: 6px;">
                    <ui:TextField picking-mode="Ignore" name="tfSearch" class="tfSearch" style="-unity-text-align: middle-left; margin-left: 0; margin-bottom: 0; margin-right: 0; margin-top: 0; width: 100%; align-self: stretch;" />
                </ui:VisualElement>
                <ui:Button name="btnTextfieldClear" class="btnTextClear" style="padding-left: 0; padding-bottom: 0; padding-right: 0; padding-top: 0; margin-left: 0; min-width: 24px; min-height: 24px; margin-right: 0; margin-bottom: 0; margin-top: 0; background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; align-self: center;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ProjectInfo" style="flex-grow: 1; flex-direction: row; align-self: stretch; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgba(0, 255, 0, 0); border-right-color: rgba(0, 255, 0, 0); border-top-color: rgba(0, 255, 0, 0); border-bottom-color: rgba(0, 255, 0, 0);">
            <ui:VisualElement name="VisualElement" style="flex-grow: 1; max-width: 350px; justify-content: flex-start; flex-direction: column; align-items: stretch; height: 100%; align-self: stretch; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); min-width: 350px;">
                <ui:VisualElement style="flex-grow: 1; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-right-width: 1px; border-left-width: 1px;">
                    <ui:ListView name="lvProjectList" style="align-self: stretch; width: 100%; background-color: rgb(48, 48, 48); border-left-color: rgb(15, 15, 15); border-right-color: rgb(15, 15, 15); border-top-color: rgb(15, 15, 15); border-bottom-color: rgb(15, 15, 15); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; flex-direction: column; height: 100%;" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; max-height: 53px; flex-direction: row; justify-content: space-between; align-self: stretch; background-color: rgb(66, 66, 64); color: rgb(226, 226, 226); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(15, 15, 15); border-right-color: rgb(15, 15, 15); border-top-color: rgb(15, 15, 15); border-bottom-color: rgb(15, 15, 15); padding-right: 15px; padding-left: 8px; min-height: 53px;">
                    <ui:Label text="Last Update 2026-08-14 08:45:55" name="lbUpdateTime" style="flex-direction: row; -unity-text-align: middle-left; -unity-font-style: italic; margin-left: 4px; margin-bottom: 4px; padding-left: 2px; font-size: 15px;" />
                    <ui:Button name="btnRefresh" class="btnRefresh" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 6px; padding-right: 6px; padding-bottom: 6px; padding-left: 6px; min-width: 35px; min-height: 35px; width: 35px; height: 35px; align-self: center; border-left-color: rgb(60, 60, 60); border-right-color: rgb(60, 60, 60); border-top-color: rgb(60, 60, 60); border-bottom-color: rgb(60, 60, 60); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; height: 100%; align-self: stretch;">
                <ui:VisualElement name="infoView" style="flex-grow: 1; background-color: rgb(58, 58, 58); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(48, 48, 48); border-right-color: rgb(48, 48, 48); border-top-color: rgb(48, 48, 48); border-bottom-color: rgb(48, 48, 48); padding-right: 0; padding-left: 0; padding-top: 0; padding-bottom: 0;">
                    <ui:VisualElement style="flex-grow: 1; max-height: 24%; flex-direction: row; justify-content: space-between; padding-right: 12px; padding-left: 12px; min-height: 60px;">
                        <ui:VisualElement style="flex-grow: 1; flex-direction: row; align-items: stretch;">
                            <ui:Label text="Display Name" name="lbDisplayName" style="-unity-text-align: middle-left; font-size: 28px; color: rgb(233, 233, 233); -unity-font-style: bold; min-height: 50px; overflow: hidden;" />
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-grow: 1; flex-direction: row-reverse; padding-right: 20px; max-width: 350px; min-width: 320px; width: auto;">
                            <ui:Button text="Install" name="btnInstall" class="btnAction" style="max-height: 28px; min-width: 120px; max-width: 150px; align-self: center; border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; border-left-color: rgb(65, 65, 65); border-right-color: rgb(65, 65, 65); border-top-color: rgb(65, 65, 65); border-bottom-color: rgb(65, 65, 65); color: rgb(226, 226, 226); margin-left: 10px; font-size: 15px;" />
                            <ui:Button text="Uninstall" name="btnUninstall" class="btnAction" style="max-height: 28px; min-width: 120px; max-width: 150px; align-self: center; border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; border-left-color: rgb(65, 65, 65); border-right-color: rgb(65, 65, 65); border-top-color: rgb(65, 65, 65); border-bottom-color: rgb(65, 65, 65); color: rgb(224, 224, 224); margin-left: 10px; font-size: 15px;" />
                            <ui:VisualElement name="localMode" style="flex-grow: 1; background-color: rgb(19, 19, 19); max-width: 50px; max-height: 40px; align-self: center; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;">
                                <ui:Label text="Local" name="lbLocal" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 13px; color: rgb(200, 93, 0); -unity-text-align: lower-center; -unity-font-style: bold;" />
                                <ui:Label text="MODE" name="lbModel" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; color: rgb(188, 139, 0); -unity-text-align: upper-center; -unity-font-style: bold; font-size: 12px;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-grow: 1; padding-right: 12px; padding-left: 12px; min-height: 110px;">
                        <ui:VisualElement style="flex-grow: 1; flex-direction: row; max-height: 35px; min-height: 35px;">
                            <ui:Label text="Author:" style="color: rgb(224, 224, 224); min-width: 80px; max-width: 80px; -unity-text-align: middle-right; -unity-font-style: bold; font-size: 15px; margin-right: 8px;" />
                            <ui:Label text="magictavernprojectauthor@email.com" name="lbAuthorEmail" style="color: rgb(224, 224, 224); -unity-text-align: middle-left; font-size: 15px;" />
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-grow: 1; flex-direction: row; max-height: 35px; min-height: 35px;">
                            <ui:Label text="Version:" style="color: rgb(224, 224, 224); min-width: 80px; max-width: 80px; -unity-text-align: middle-right; -unity-font-style: bold; font-size: 15px; margin-right: 8px;" />
                            <ui:Button text="" name="ddVersion" style="align-self: center; margin-top: 3px; margin-right: 10px; margin-bottom: 3px; margin-left: 0; padding-top: 0; padding-bottom: 0; padding-left: 8px; padding-right: 8px; -unity-text-align: middle-left; font-size: 12px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; color: rgb(231, 231, 231); min-width: 80px; max-height: 30px; height: 30px; min-height: 30px; width: auto;" />
                            <ui:Label text="Release" name="lbReleaseType" style="color: rgb(0, 202, 0); min-width: 65px; max-width: 65px; -unity-text-align: middle-center; -unity-font-style: normal; min-height: 25px; max-height: 25px; align-self: center; border-left-color: rgb(0, 149, 0); border-right-color: rgb(0, 149, 0); border-top-color: rgb(0, 149, 0); border-bottom-color: rgb(0, 149, 0); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 2px; border-top-right-radius: 2px; border-bottom-right-radius: 2px; border-bottom-left-radius: 2px; background-color: rgb(50, 50, 50);" />
                            <ui:Label text="Debug" name="lbDebugType" style="color: rgb(255, 135, 0); min-width: 65px; max-width: 65px; -unity-text-align: middle-center; -unity-font-style: normal; min-height: 25px; max-height: 25px; align-self: center; border-left-color: rgb(200, 114, 0); border-right-color: rgb(200, 114, 0); border-top-color: rgb(200, 114, 0); border-bottom-color: rgb(200, 114, 0); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 2px; border-top-right-radius: 2px; border-bottom-right-radius: 2px; border-bottom-left-radius: 2px; background-color: rgb(50, 50, 50);" />
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-grow: 1; flex-direction: row; max-height: 35px; min-height: 35px;">
                            <ui:Label text="Package:" style="color: rgb(224, 224, 224); min-width: 80px; max-width: 80px; -unity-text-align: middle-right; -unity-font-style: bold; margin-right: 8px; font-size: 15px;" />
                            <ui:Label text="com.magictavern.tag.packagename" name="lbPackageName" style="color: rgb(224, 224, 224); -unity-text-align: middle-left; -unity-font-style: italic; font-size: 15px;" />
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-grow: 1; flex-direction: row; max-height: 40px; min-height: 40px; padding-top: 5px; padding-bottom: 5px;">
                            <ui:Label text="Documentation" name="lbDocumentation" class="label-hover-link" style="color: rgb(65, 119, 255); -unity-text-align: middle-center; padding-right: 12px; padding-left: 12px; margin-left: 0; margin-right: 0; font-size: 15px;" />
                            <ui:Label text="Licenses" name="lbLicenses" class="label-hover-link" style="color: rgb(65, 119, 255); -unity-text-align: middle-center; padding-right: 12px; padding-left: 12px; border-left-color: rgb(25, 25, 25); border-right-color: rgb(25, 25, 25); border-top-color: rgb(25, 25, 25); border-bottom-color: rgb(25, 25, 25); border-left-width: 1px; margin-left: 0; margin-right: 0; font-size: 15px;" />
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-grow: 1;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="tabs" style="flex-grow: 1; max-height: 35px; flex-direction: row; min-height: 35px; align-items: flex-end;" />
                </ui:VisualElement>
                <ui:VisualElement name="tabView" style="flex-grow: 1; background-color: rgb(44, 44, 44); border-left-color: rgb(44, 44, 44); border-right-color: rgb(44, 44, 44); border-top-color: rgb(44, 44, 44); border-bottom-color: rgb(44, 44, 44); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; min-height: 64%; max-height: 64%;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
