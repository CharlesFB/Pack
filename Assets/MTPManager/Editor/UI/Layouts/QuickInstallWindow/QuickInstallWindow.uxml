<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/MTPManager/Editor/UI/Styles/QuickInstallWindow.uss?fileID=7433441132597879392&amp;guid=113df80a2fe654672b8ec8c784ba6c25&amp;type=3#QuickInstallWindow" />
    <ui:VisualElement style="flex-grow: 1; width: 100%; height: 100%; background-color: rgb(58, 58, 58); padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px;">
        <ui:VisualElement style="flex-grow: initial; min-height: 30px; max-height: 30px; flex-direction: row; justify-content: space-between;">
            <ui:Label tabindex="-1" text="选择安装清单：" parse-escape-sequences="true" display-tooltip-when-elided="true" style="-unity-text-align: middle-left; color: rgb(231, 231, 231); margin-left: 4px;" />
            <ui:Toggle label="全选" name="tgAll" style="-unity-text-align: middle-right; color: rgb(231, 231, 231);" />
        </ui:VisualElement>
        <ui:ListView name="lvItemList" virtualization-method="DynamicHeight" style="flex-grow: 1; background-color: rgb(31, 31, 31); margin-top: 2px; margin-bottom: 2px; margin-right: 2px; margin-left: 2px; padding-top: 4px; padding-right: 2px; padding-bottom: 4px; padding-left: 4px;" />
        <ui:VisualElement style="flex-grow: initial; height: auto; min-height: 90px; max-height: 90px;">
            <ui:Button text="Install" parse-escape-sequences="true" display-tooltip-when-elided="true" name="btnInstall" style="flex-grow: 1; flex-shrink: 1;" />
            <ui:Button text="Reset" parse-escape-sequences="true" display-tooltip-when-elided="true" name="btnReset" style="flex-grow: 1; flex-shrink: 1;" />
            <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                <ui:Button text="Save" parse-escape-sequences="true" display-tooltip-when-elided="true" name="btnSave" style="flex-grow: 1; border-bottom-left-radius: 5px;" />
                <ui:Button text="Load" parse-escape-sequences="true" display-tooltip-when-elided="true" name="btnLoad" style="flex-grow: 1; border-bottom-right-radius: 5px;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
