<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; min-height: 32px; max-height: 32px; flex-direction: row-reverse; height: auto; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; background-color: rgb(65, 65, 65); border-bottom-width: 1px; border-left-color: rgb(24, 24, 24); border-right-color: rgb(24, 24, 24); border-top-color: rgb(24, 24, 24); border-bottom-color: rgb(24, 24, 24);">
        <ui:Toggle name="tgState" />
        <ui:Button text="package-1.0.0" parse-escape-sequences="true" display-tooltip-when-elided="true" name="btnVersion" style="min-width: 280px; max-width: 280px;" />
        <ui:Label tabindex="-1" text="PackageDisplayName" parse-escape-sequences="true" display-tooltip-when-elided="true" name="lbDisplayName" style="flex-grow: 1; -unity-text-align: middle-left; color: rgb(255, 200, 60); padding-right: 2px; padding-left: 5px;" />
        <ui:VisualElement style="flex-grow: 1; min-width: 290px; max-width: 290px; flex-direction: row;">
            <ui:Label tabindex="-1" text="  " parse-escape-sequences="true" display-tooltip-when-elided="true" name="lbInstalled" style="-unity-text-align: middle-center; background-color: rgb(0, 136, 0); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 5px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; min-width: 10px; min-height: 10px; max-height: 10px; max-width: 10px; align-self: center; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;" />
            <ui:Label tabindex="-1" text="DEP" parse-escape-sequences="true" display-tooltip-when-elided="true" name="lbDep" style="-unity-text-align: middle-center; background-color: rgb(10, 10, 10); color: rgb(231, 231, 231); font-size: 9px; -unity-font-style: bold; padding-right: 10px; padding-left: 10px; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; min-width: 30px; max-width: 30px; padding-top: 0; padding-bottom: 0; margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px;" />
            <ui:Label tabindex="-1" text="com.magictavern.packagename" parse-escape-sequences="true" display-tooltip-when-elided="true" name="lbPackageName" style="flex-grow: 1; -unity-text-align: middle-left; color: rgb(238, 238, 238); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; max-width: 240px; min-width: auto; overflow: hidden; text-overflow: ellipsis; padding-top: 0; padding-right: 5px; padding-bottom: 0; padding-left: 5px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
