/* TabView 通用组件样式。
 * 结构（Tab 按钮 / 内容页）由 TabView.cs 动态创建，这里只负责外观，
 * 修改颜色/间距无需改代码。
 */

.tab-view {
    flex-direction: column;
    flex-grow: 1;
    margin-top: 10px;
}

.tab-view__tab-bar {
    flex-direction: row;
    height: 28px;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(51, 51, 51, 0.2);
}

.tab-view__content-container {
    flex-grow: 1;
    margin-top: 0;
    margin-bottom: 2px;
    padding-left: 0;
    padding-right: 0;
}

.tab-view__page {
    flex-grow: 1;
    padding-top: 12px;
    padding-bottom: 5px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgb(45, 43, 44);
}

.tab-button {
    flex-grow: 0;
    flex-shrink: 0;
    height: 28px;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 10px;
    padding-right: 10px;
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: 1px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    transition-duration: 0.2s;
}

.tab-button:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

.tab-button--active {
    border-bottom-color: rgb(255, 255, 255);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

/* 写在 .tab-button:hover 之后：同等特异度下，后写的规则生效，
 * 用于避免激活态 Tab 再叠加一层 hover 背景。
 */
.tab-button--active:hover {
    background-color: rgba(0, 0, 0, 0);
}
