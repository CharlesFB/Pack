.btnNav {
    background-color: rgb(71, 71, 71);
    border-radius: 0;
}

.btnRefresh {
    background-color: rgb(90, 90, 90);
    border-radius: 0;
}

.btnAction {
    background-color: rgb(90, 90, 90);
    border-radius: 0;
}

.ddType {
    background-color: rgb(71, 71, 71);
    background-image: none;
    border-radius: 0;
    flex-direction: row;
    align-items: center;
    color: rgb(220, 220, 220);
}

.ddType:hover {
    background-color: rgb(90, 90, 90);
    color: rgb(255, 255, 255);
}

.tfSearch > .unity-base-field__label {
    color: rgb(200, 200, 200);
    width: 0;
    border-width: 0;
    margin: 0;
    padding: 0;
}

.tfSearch .unity-base-field__label {
    color: rgb(200, 200, 200);
    width: 0;
    border-width: 0;
    margin: 0;
    padding: 0;
}

.tfSearch .unity-base-text-field__input {
    background-color: rgb(45, 45, 45);
    background-image: none;
    border-width: 1px;
    border-color: rgb(35, 35, 35);
    border-radius: 5px;
    padding: 0;
    color: rgb(230, 230, 230);
}

.tfSearch .unity-text-field__input {
    background-color: rgb(45, 45, 45);
    background-image: none;
    border-width: 1px;
    border-color: rgb(35, 35, 35);
    border-radius: 5px;
    padding: 0;
    color: rgb(230, 230, 230);
}

.tfSearch .unity-text-element {
    color: rgb(230, 230, 230);
}

#ddVersion {
    background-color: rgb(80, 80, 80);
    background-image: none;
    border-radius: 3px;
    flex-direction: row;
    align-items: center;
    color: rgb(220, 220, 220);
}

#ddVersion Label {
    color: rgb(220, 220, 220);
    font-size: 12px;
}

#ddVersion:hover {
    background-color: rgb(90, 90, 90);
    color: rgb(255, 255, 255);
}

#ddVersion:hover Label {
    color: rgb(255, 255, 255);
}
