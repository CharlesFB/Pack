    background-color: rgb(80, 80, 80);
    background-image: none;
    min-height: 24px;
    width: auto;
    border-width: 0;
}

#ddVersion .unity-base-field__label {
    width: 0;
    border-width: 0;
    margin: 0;
    padding: 0;
}

#ddVersion .unity-base-popup-field__text {
    color: rgb(220, 220, 220);
    margin-left: 4px;
}

#ddVersion .unity-base-popup-field__arrow {
    width: 12px;
    height: 12px;
    background-image: url("project://database/Assets/Editor/UI/Imgs/xiala.png?fileID=21300000&guid=a813e43e1813549928b0ca512f0423d7&type=3#xiala");
    margin-right: 5px;
    margin-left: 4px;
