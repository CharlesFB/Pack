# Only cloudflared reaches this container; no host ports are published.
:8080 {
    @insecure header X-Forwarded-Proto http
    redir @insecure https://{host}{uri} permanent
    encode gzip
    request_body {
        max_size 3MB
    }
    handle_path /static/* {
        root * /srv/static
        file_server
    }
    handle {
        reverse_proxy web:8000 {
            header_up X-Forwarded-Proto https
        }
    }
}
